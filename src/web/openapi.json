{"openapi":"3.1.0","info":{"title":"Sidefeed API","version":"0.1.0","description":"Aggregate, filter, search, exchange, and publish feeds."},"servers":[{"url":"/"}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer"}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"string"}}}}},"paths":{"/.well-known/webfinger":{"get":{"summary":"WebFinger for the node actor","description":"Resolves acct:sidefeed@host and the actor URL. Served only when SIDEFEED_AP_ENABLED=1.","parameters":[{"name":"resource","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"JRD document"},"404":{"description":"Unknown resource or ActivityPub disabled"}}}},"/ap/v1/actor":{"get":{"summary":"Node actor document","description":"Served only when SIDEFEED_AP_ENABLED=1; otherwise 404.","responses":{"200":{"description":"Actor"},"404":{"description":"ActivityPub disabled"}}}},"/ap/v1/inbox":{"post":{"summary":"ActivityPub inbox","description":"Inert 404 unless SIDEFEED_AP_ENABLED=1. Understands Accept{Follow} and Create only.","responses":{"200":{"description":"Delivery handled"},"401":{"description":"Bad signature"},"404":{"description":"ActivityPub disabled"}}}},"/api/v1/ai/status":{"get":{"summary":"AI provider status and backlogs","description":"Live enrich and embedding providers plus their pending-item counts. Always 200, even with both providers disabled.","responses":{"200":{"description":"Provider status"}}}},"/api/v1/bookmarks":{"get":{"summary":"List saved items","description":"The reader saved list. Token-free, like the rest of the public read path.","responses":{"200":{"description":"Saved items, newest save first"}}}},"/api/v1/feeds":{"get":{"summary":"List feeds","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Feeds"}}},"post":{"summary":"Create feed","security":[{"bearerAuth":[]}],"responses":{"201":{"description":"Created"}}}},"/api/v1/feeds/{slug}/ask":{"post":{