ription":"Thread posts"}}}},"/healthz":{"get":{"summary":"Liveness","responses":{"200":{"description":"Healthy"}}}},"/readyz":{"get":{"summary":"Database readiness","responses":{"200":{"description":"Ready"}}}},"/api/v1/updates":{"get":{"summary":"Recent updates rollup","description":"Per-category rollup of what moved recently; token-free, public feeds only.","responses":{"200":{"description":"Updates"}}}},"/api/v1/items/{id}/embed":{"post":{"summary":"Embed one item","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"201":{"description":"Vector stored"}}}},"/api/v1/feeds/{slug}/items/{item_id}/summarize":{"post":{"summary":"Summarize one public item on demand","description":"Token-free for public feeds; stores the artifact so later reads are cached.","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}},{"name":"item_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Tags and summary"}}}},"/api/v1/peers/{id}/sync":{"post":{"summary":"Sync one peer now","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Merge result"}}}},"/federation/v1/items":{"get":{"summary":"Export public items to peers","description":"HMAC-signed peer export; only public items.","responses":{"200":{"description":"Public items"}}}},"/api/v1/feeds/{slug}/sources/{source_id}":{"post":{"summary":"Attach a source to a feed","security":[{"bearerAuth":[]}],"parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}},{"name":"source_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Attached"}}}}}}