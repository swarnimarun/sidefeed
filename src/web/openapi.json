y via the x-sidefeed-signature HMAC header. Batches over 100 items answer 413.","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"202":{"description":"Batch accepted"},"401":{"description":"Bad or missing channel secret"},"404":{"description":"Unknown channel"},"413":{"description":"Batch exceeds 100 items"}}}},"/api/v1/items/{id}/bookmark":{"post":{"summary":"Save an item","description":"Token-free, bounded single-user write. 204 when saved, 404 for an unknown item, 409 when the cap is reached.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Saved"},"404":{"description":"Unknown item"},"409":{"description":"Bookmark limit reached"}}},"delete":{"summary":"Remove a saved item","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Removed"}}}},"/api/v1/items/{id}/enrich":{"post":{"summary":"Derive tags and a summary now","security":[{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"201":{"description":"Tags and summary"}}}},"/api/v1/items/{id}/similar":{"get":{"summary":"Related items for one article","description":"Blends the same source, the same link host, shared derived tags, and shared title keywords. Token-free; only public items are returned.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50}}],"responses":{"200":{"description":"Ranked related items"}}}},"/api/v1/keys":{"post":{"summary":"Mint a scoped API key (lane-authsec Task 1)","security":[{"bearerAuth":[]}],"responses":{"201":{"description":"Created; includes one-time plaintext token"},"429":{"description":"Strict key-management bucket spent; Retry-After set"}}}},"/api/v1/keys/{id}":{"delete":{"summary":"Revoke a scoped API key","security":[{"