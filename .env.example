SIDEFEED_LISTEN=0.0.0.0:8080
SIDEFEED_PUBLIC_URL=http://localhost:8080
SIDEFEED_DATABASE_URL=sqlite://sidefeed.db?mode=rwc
SIDEFEED_ADMIN_TOKEN=replace-with-a-long-random-token
# Optional: serve the UI from this directory instead of the embedded copy.
# Assets are read per request, so edits apply without a rebuild or restart.
# SIDEFEED_WEB_DIR=/var/lib/sidefeed/web
SIDEFEED_FETCH_INTERVAL_SECONDS=900
SIDEFEED_FETCH_TIMEOUT_SECONDS=20
SIDEFEED_MAX_RESPONSE_BYTES=5242880
SIDEFEED_PEER_MAX_ITEMS=500
SIDEFEED_RETENTION_DAYS=90
# 0 keeps history forever (pruning keys on fetch time, not publish date)
SIDEFEED_EMBEDDING_PROVIDER=disabled

# Tags and generated summaries. Artifacts are stored in SQLite; only the
# cache below is held in memory. disabled | heuristic | openai
SIDEFEED_ENRICH_PROVIDER=disabled
SIDEFEED_ENRICH_BATCH=20
SIDEFEED_ENRICH_INTERVAL_SECONDS=30
SIDEFEED_ENRICH_MAX_CHARS=8000
SIDEFEED_ENRICH_CACHE_ENTRIES=128
# For a small local model over an OpenAI-compatible endpoint:
# SIDEFEED_ENRICH_PROVIDER=openai
# SIDEFEED_ENRICH_URL=http://127.0.0.1:11434/v1/chat/completions
# SIDEFEED_ENRICH_MODEL=qwen2.5:1.5b
# SIDEFEED_ENRICH_TOKEN=
# SIDEFEED_EMBEDDING_URL=https://embedding.example/v1/embeddings
# SIDEFEED_EMBEDDING_TOKEN=secret

# Tiny-local embeddings via ONNX Runtime. Opt-in: the binary must be built with
# `--features onnx-local` AND this must point at a model file. The supported
# artifact is a quantized MiniLM-L6-v2 `.onnx` (~23 MB int8) plus its tokenizer
# file; weights are operator-supplied and never vendored. Vectors are 384 dims,
# L2-normalized, cosine-compatible with the existing embeddings table, so no
# migration is needed when the real weights land.
# SIDEFEED_EMBEDDING_PROVIDER=onnx-local
# SIDEFEED_ONNX_EMBED_MODEL=/var/lib/sidefeed/models/minilm-l6-v2-int8.onnx
